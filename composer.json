{
    "name": "l369/psyche-ai",
    "description": "PsycheAI - Plataforma para observação longitudinal do discurso humano.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
