{
    "name": "l369/psyche-ai",
    "description": "PsycheAI - Plataforma para observação longitudinal do discurso humano.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "anthropic-ai/sdk": "^0.40.0",
        "symfony/http-client": "^8.1",
        "nyholm/psr7": "^1.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "PsycheAI\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "PsycheAI\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
