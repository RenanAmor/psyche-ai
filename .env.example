APP_NAME="Psyche AI"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# URL base da API REST (Sprint 10) consumida pela interface web (Sprint 11B).
PSYCHEAI_API_BASE_URL=http://localhost:8000

# Chave da API da Anthropic, usada por AnthropicLLMService (revisão
# pós-Sprint 17: classificação estrutural via LLM no Motor Freud).
ANTHROPIC_API_KEY=

# Prefixo de base (ex.: "/psycheai") para rodar a interface web sob um
# subcaminho de um domínio compartilhado (Sprint 21) — deixe vazio para
# a Web ser dona da raiz do domínio, como em desenvolvimento local. Só a
# Web usa isso; a API REST não precisa (é chamada só servidor-a-servidor).
PSYCHEAI_BASE_PATH=

