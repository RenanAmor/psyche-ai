APP_NAME="Psyche AI"
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo

# URL base da API REST (Sprint 10) consumida pela interface web (Sprint 11B).
PSYCHEAI_API_BASE_URL=http://localhost:8000

# Chave da API da Anthropic, usada por AnthropicLLMService (revisão
# pós-Sprint 17: classificação estrutural via LLM no Motor Freud).
ANTHROPIC_API_KEY=

# SMTP autenticado usado por SmtpEmailService para o e-mail de confirmação
# da lista de espera da ECO (ListaDeEsperaApplicationService). Em produção,
# a caixa é contato@investimentos369.com via smtp.hostinger.com:465. Sem
# essas variáveis, o envio falha silenciosamente (a inscrição continua
# sendo salva normalmente — ver ListaDeEsperaApplicationService).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="PsycheAI"

# Segunda identidade SMTP, usada só quando uma inscrição na lista de
# espera chega com "origem": "ecopsy" (formulário estático publicado em
# ecopsy.online) — caixa própria contato@ecopsy.online, distinta da
# identidade padrão acima. Sem essas variáveis, a inscrição ainda é salva
# normalmente, mas o e-mail de confirmação cai de volta na identidade
# padrão (mesmo comportamento de "falha silenciosa" do bloco SMTP acima).
SMTP_ECOPSY_HOST=
SMTP_ECOPSY_PORT=465
SMTP_ECOPSY_USER=
SMTP_ECOPSY_PASSWORD=
MAIL_ECOPSY_FROM_ADDRESS=
MAIL_ECOPSY_FROM_NAME="ECO · PsycheAI"

# Origens de navegador autorizadas a chamar esta API direto via
# fetch()/CORS (separadas por vírgula) — hoje só o formulário estático de
# ecopsy.online, que faz POST /waitlist direto do navegador do visitante.
# Vazio = CORS desligado (comportamento anterior, API só chamada
# servidor-a-servidor pela Web).
CORS_ALLOWED_ORIGINS=

# Prefixo de base (ex.: "/psycheai") para rodar a interface web sob um
# subcaminho de um domínio compartilhado (Sprint 21) — deixe vazio para
# a Web ser dona da raiz do domínio, como em desenvolvimento local. Só a
# Web usa isso; a API REST não precisa (é chamada só servidor-a-servidor).
PSYCHEAI_BASE_PATH=

# Transporte de produção (bin/transportar-producao.php) — ver
# docs/architecture/Transporte-Producao-PsycheAI.md. Conta FTP restrita a
# psycheai-app/ criada no hPanel da Hostinger (esta hospedagem não tem
# SSH). PRODUCTION_FTP_REMOTE_PATH fica "/" porque a própria conta FTP já
# é restrita ao diretório certo — não precisa (nem deve) apontar de novo
# para "psycheai-app" aqui dentro.
PRODUCTION_FTP_HOST=ftp.investimentos369.com
PRODUCTION_FTP_PORT=21
PRODUCTION_FTP_USER=
PRODUCTION_FTP_PASSWORD=
PRODUCTION_FTP_REMOTE_PATH=/

